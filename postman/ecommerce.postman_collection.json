{
  "info": {
    "_postman_id": "0f2a8c40-7b91-4d3e-9c22-1a5e6d8f0001",
    "name": "E-Commerce Microservices",
    "description": "A plain collection for driving the API by hand: one folder per resource, no assertions.\n\nRun the folders **top to bottom on a fresh start** — Auth saves a token, Catalogue saves a product id, and the later folders use them.\n\nSelect the `ecommerce · local` environment before running anything.\n\nThe assertion-heavy version, with the deliberately-failing requests and the cache and rate-limit checks, was removed on purpose while the order workflow is being built. It is in git history if it is wanted back.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs before every request in the collection.",
          "const required = ['gatewayUrl', 'apiPrefix', 'password'];",
          "const missing = required.filter((key) => !pm.environment.get(key));",
          "if (missing.length > 0) {",
          "  throw new Error(",
          "    `Missing environment variable(s): ${missing.join(', ')}. ` +",
          "    'Select the \"ecommerce · local\" environment in the top-right picker.'",
          "  );",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "note",
      "value": "All real values live in the environment, not here, so the collection can be shared without carrying anyone's tokens.",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 · Auth",
      "description": "Register saves the token every other folder uses. Register generates a fresh email each run, so it can be re-run any number of times.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(`email`, `ada+${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.environment.set('accessToken', b.tokens.accessToken);",
                  "pm.environment.set('userId', b.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/auth/register",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "auth",
                "register"
              ]
            },
            "description": "A fresh email per run, so the unique index never turns this into a 409."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('accessToken', pm.response.json().tokens.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "auth",
                "login"
              ]
            },
            "description": "200, not 201 — logging in creates nothing."
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/auth/me",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "auth",
                "me"
              ]
            },
            "description": "The profile behind the current token."
          }
        }
      ]
    },
    {
      "name": "2 · Catalogue",
      "description": "Category → product → publish → read. The product created here is what the Inventory, Cart and Orders folders use.",
      "item": [
        {
          "name": "Create category",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now().toString().slice(-8);",
                  "pm.environment.set(`categorySlug`, `laptops-${stamp}`);",
                  "pm.environment.set(`categoryName`, `Laptops ${stamp}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('categoryId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{categoryName}}\",\n  \"slug\": \"{{categorySlug}}\",\n  \"description\": \"Portable computers\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/categories",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "categories"
              ]
            },
            "description": "Slug and name are both uniquely indexed, so both are generated per run."
          }
        },
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/categories",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "categories"
              ]
            }
          }
        },
        {
          "name": "Create product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now().toString().slice(-8);",
                  "pm.environment.set(`productSku`, `LAP-X1C-${stamp}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('productId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ThinkPad X1 Carbon\",\n  \"description\": \"14-inch business laptop\",\n  \"sku\": \"{{productSku}}\",\n  \"price\": 1899,\n  \"categoryId\": \"{{categoryId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/products",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "products"
              ]
            },
            "description": "Note the response: `price` comes back as the string \"1899.00\", and `status` is DRAFT. Nothing goes on sale by accident."
          }
        },
        {
          "name": "Publish the product (DRAFT → ACTIVE)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/products/{{productId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "products",
                "{{productId}}"
              ]
            },
            "description": "Required before the Cart folder: a DRAFT product cannot be added to a cart."
          }
        },
        {
          "name": "Get product by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/products/{{productId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "products",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/products",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "products"
              ]
            }
          }
        },
        {
          "name": "List products — filter, sort, paginate",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/products",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "products"
              ],
              "query": [
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}"
                },
                {
                  "key": "minPrice",
                  "value": "100"
                },
                {
                  "key": "sortBy",
                  "value": "price"
                },
                {
                  "key": "sortOrder",
                  "value": "asc"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          }
        },
        {
          "name": "Update the price",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1599.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/products/{{productId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "products",
                "{{productId}}"
              ]
            },
            "description": "A partial update: send only what changes. With RabbitMQ running this also publishes `product.price_changed`."
          }
        }
      ]
    },
    {
      "name": "3 · Inventory",
      "description": "Stock is three numbers: `onHand`, `reserved`, and `available` — which is derived, never stored. Run this after the Catalogue folder.",
      "item": [
        {
          "name": "Register the product with inventory",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('inventoryId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"sku\": \"{{productSku}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/inventory",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "inventory"
              ]
            },
            "description": "Opens at zero. Nothing arrives by magic."
          }
        },
        {
          "name": "Receive 10 units",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 10,\n  \"reference\": \"PO-2026-0042\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/inventory/{{productId}}/receive",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "inventory",
                "{{productId}}",
                "receive"
              ]
            },
            "description": "Goods arrived: `onHand` goes up."
          }
        },
        {
          "name": "Reserve 3",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3,\n  \"reference\": \"order:demo-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/inventory/{{productId}}/reserve",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "inventory",
                "{{productId}}",
                "reserve"
              ]
            },
            "description": "Promised to an order. `onHand` is unchanged — the goods are still in the warehouse — but `available` drops."
          }
        },
        {
          "name": "Release 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1,\n  \"reference\": \"order:demo-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/inventory/{{productId}}/release",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "inventory",
                "{{productId}}",
                "release"
              ]
            },
            "description": "The promise is cancelled. This is the undo for a reservation."
          }
        },
        {
          "name": "Fulfil 2",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2,\n  \"reference\": \"order:demo-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/inventory/{{productId}}/fulfil",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "inventory",
                "{{productId}}",
                "fulfil"
              ]
            },
            "description": "Shipped: BOTH `onHand` and `reserved` go down."
          }
        },
        {
          "name": "Adjust −1 for breakage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"delta\": -1,\n  \"reason\": \"damaged in handling\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/inventory/{{productId}}/adjust",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "inventory",
                "{{productId}}",
                "adjust"
              ]
            },
            "description": "A signed correction with a mandatory reason. An unexplained adjustment is indistinguishable from theft."
          }
        },
        {
          "name": "Read the ledger",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/inventory/{{productId}}/movements",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "inventory",
                "{{productId}}",
                "movements"
              ]
            },
            "description": "Every movement, append-only. The balance without this history could not be audited."
          }
        },
        {
          "name": "Current position",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/inventory/{{productId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "inventory",
                "{{productId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4 · Cart",
      "description": "Always *your* cart — there is no `:cartId` in any route, so there is no id to tamper with. Needs a token from folder 1 and an ACTIVE product from folder 2.",
      "item": [
        {
          "name": "GET /cart — get or create",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('cartId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/cart",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "cart"
              ]
            },
            "description": "An empty cart, not a 404. Calling it repeatedly yields the same one."
          }
        },
        {
          "name": "Add a product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/cart/items",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "cart",
                "items"
              ]
            },
            "description": "Note what the response contains that the request did not: `name` and `unitPrice`. Both are snapshotted by the server from the catalogue."
          }
        },
        {
          "name": "Add the same product again",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/cart/items",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "cart",
                "items"
              ]
            },
            "description": "An upsert: quantity 3 on one line, not a second line."
          }
        },
        {
          "name": "Set an absolute quantity",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/cart/items/{{productId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "cart",
                "items",
                "{{productId}}"
              ]
            },
            "description": "PATCH sets the quantity; it is not a delta."
          }
        },
        {
          "name": "Remove a line",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/cart/items/{{productId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "cart",
                "items",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Empty the cart",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/cart",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "cart"
              ]
            },
            "description": "Empties it and KEEPS it — the row carries the identity abandonment analytics rely on."
          }
        }
      ]
    },
    {
      "name": "5 · Orders",
      "description": "Milestone 8, step 1 — the simple version. `POST /orders` reads your cart, copies the lines into an order in one local transaction, and returns it CONFIRMED.\n\nTwo requests near the end show what it does NOT do yet: the cart is not emptied, and no stock is reserved. Step 2 adds the saga and the outbox that fix both.",
      "item": [
        {
          "name": "Add something to the cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/cart/items",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "cart",
                "items"
              ]
            },
            "description": "So there is something to order."
          }
        },
        {
          "name": "POST /orders — place the order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.environment.set('orderId', b.id);",
                  "pm.environment.set('orderNumber', b.orderNumber);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/orders",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "orders"
              ]
            },
            "description": "An EMPTY body. The lines come from the cart and the owner from the verified token — a client that could name its own prices would order a laptop for a penny."
          }
        },
        {
          "name": "GET /orders/:id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/orders/{{orderId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "GET /orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/orders",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "orders"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Yours only, newest first, in a paginated envelope."
          }
        },
        {
          "name": "The cart is still full (step 2 fixes this)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/cart",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "cart"
              ]
            },
            "description": "Emptying the cart means writing to another service’s database, which cannot join the transaction that wrote the order. Step 2 publishes `order.confirmed` and lets the Cart Service convert its own cart."
          }
        },
        {
          "name": "Stock did not move (step 2 fixes this)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/inventory/{{productId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "inventory",
                "{{productId}}"
              ]
            },
            "description": "`reserved` is unchanged: nothing calls the Inventory Service, so two customers could both order the last unit. Step 2 reserves per line — the first write into another service’s database, and therefore the first thing that has to be undoable."
          }
        },
        {
          "name": "Cancel the order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed my mind\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/orders/{{orderId}}/cancel",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "orders",
                "{{orderId}}",
                "cancel"
              ]
            },
            "description": "A status change and nothing more today, because nothing was reserved and nobody was charged. In step 2 this has to release stock."
          }
        }
      ]
    },
    {
      "name": "6 · Cleanup",
      "description": "Run last, or not at all. Deleting the product makes the Inventory, Cart and Orders folders fail until the Catalogue folder is run again.",
      "item": [
        {
          "name": "Delete product (soft)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/{{apiPrefix}}/products/{{productId}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "products",
                "{{productId}}"
              ]
            },
            "description": "Soft delete: the row stays and `deleted_at` is set, so orders that reference this product still make sense. Kept in its own folder because deleting the product breaks every folder above it."
          }
        }
      ]
    }
  ]
}
