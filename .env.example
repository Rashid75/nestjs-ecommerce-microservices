# ---------------------------------------------------------------------------
# Milestone 1 — API Gateway only.
#
# Copy this file to `.env` and adjust values for your machine:
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real secrets, credentials or tokens.
# Later milestones will add DATABASE_*, REDIS_*, RABBITMQ_URL, JWT_* and
# SMTP_* entries here as those components are introduced.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the API Gateway listens on
PORT=3000

# URL prefix applied to every route (http://localhost:3000/api/...)
API_GLOBAL_PREFIX=api
