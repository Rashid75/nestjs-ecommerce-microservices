# ---------------------------------------------------------------------------
# Milestone 2 — API Gateway + Auth Service.
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored. This file is committed and must NEVER contain a real
# secret. Every service in the monorepo reads this one file in local
# development; in production each service receives its own environment from the
# orchestrator and no .env exists at all.
#
# Database variables are PREFIXED PER SERVICE (AUTH_DB_*, later PRODUCT_DB_*,
# ORDER_DB_*). Each service owns its own database — that is the
# database-per-service rule — so an unprefixed DB_HOST would collide as soon as
# the second service appears.
# ---------------------------------------------------------------------------

# --- Shared ---
# --- Logging (every service) ---
# trace | debug | info | warn | error | fatal
# Turning this up during an incident is an environment change, not a deploy.
LOG_LEVEL=debug
# Colourised human-readable lines instead of JSON. true locally, FALSE
# anywhere a log shipper is reading, which needs the JSON.
LOG_PRETTY=true

# --- Tracing (every service) ---
# Off by default: the SDK, the instrumentation and the exporter all cost
# something, and none of it is useful until you are looking at it.
#
# OTEL_EXPORTER=console  prints spans to stdout. Needs NOTHING installed, and
#                        is the fastest way to see what a trace actually is.
# OTEL_EXPORTER=otlp     sends to a collector at OTEL_EXPORTER_OTLP_ENDPOINT.
#                        SigNoz listens on 4318; see the README.
#
# OTEL_SERVICE_NAME is set PER SERVICE by its serve target, not here — one
# value in this file would label all eight services identically.
OTEL_ENABLED=false
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# development | test | production
NODE_ENV=development

# --- API Gateway (public) ---
API_GATEWAY_PORT=3000
# URL prefix on every gateway route: http://localhost:3000/api/auth/login
API_GLOBAL_PREFIX=api
# Where the gateway forwards authentication calls.
AUTH_SERVICE_URL=http://127.0.0.1:3001
# Where the gateway forwards catalogue calls.
PRODUCT_SERVICE_URL=http://127.0.0.1:3002
INVENTORY_SERVICE_URL=http://127.0.0.1:3003
CART_SERVICE_URL=http://127.0.0.1:3004
ORDER_SERVICE_URL=http://127.0.0.1:3005
PAYMENT_SERVICE_URL=http://127.0.0.1:3006
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3007
# Deadline for every outbound call the gateway makes, in milliseconds.
HTTP_CLIENT_TIMEOUT_MS=5000

# --- Auth Service (internal, bound to 127.0.0.1) ---
AUTH_SERVICE_PORT=3001

# --- Auth Service database ---
# NAMING CONVENTION: every PostgreSQL database AND login role this project
# creates is prefixed `ecommerce_` — e.g. ecommerce_auth_db owned by
# ecommerce_auth_service, later ecommerce_product_db owned by
# ecommerce_product_service.
#
# Databases are per-cluster but ROLES ARE CLUSTER-WIDE in PostgreSQL, so an
# unprefixed `auth_service` would sit in the same namespace as every other
# project sharing this local server. The prefix keeps ownership obvious in
# `\du` and makes a stray GRANT easy to spot.
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_USERNAME=ecommerce_auth_service
# Set your own local development password. It never leaves this machine and is
# never logged. Do not reuse a password from anywhere else.
AUTH_DB_PASSWORD=change-me
AUTH_DB_DATABASE=ecommerce_auth_db
# Logs the SQL Sequelize actually emits. ON in development because seeing the
# real statements is the point; MUST be off in production.
AUTH_DB_LOGGING=true
# Local Postgres over loopback needs no TLS. This must be true for anything
# reachable over a network.
AUTH_DB_SSL=false

# --- Auth Service tokens ---
# --- JWT signing keys (RS256) ---
# NOT a secret in this file: these are PATHS. Generate the keypair with:
#   node tools/generate-jwt-keys.mjs
#
# RS256 is asymmetric, and that is the whole point:
#   private key  Auth Service only. SIGNS. Never leaves that process.
#   public key   everyone. VERIFIES. Cannot forge anything, so it can be
#                distributed freely — including to the public-facing gateway.
#
# Under the old HS256 secret, any process that could CHECK a token could also
# MINT one, which is why the gateway could not verify tokens at all until now.
#
# The keys/ directory is git-ignored. A deployed environment mounts the
# private key from a secret manager and points this at the mount path.
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
# Access token lifetime. Short (15 minutes) because an access token cannot be
# revoked before it expires. Refresh tokens arrive in a later milestone.
JWT_ACCESS_TTL_SECONDS=900
# Refresh token lifetime. 30 days, and long is SAFE here only because this
# token is STATEFUL — it is checked against a row that can be revoked, unlike
# the access token, which is checked by signature and cannot be. Max 90 days:
# a session that never ends is not a feature, it is a credential you have
# lost track of.
REFRESH_TOKEN_TTL_SECONDS=2592000
# bcrypt work factor. Each +1 doubles the hashing time. 12 is a reasonable
# 2026 default; raise it as hardware improves.
BCRYPT_COST=12

# --- Product Service (internal, bound to 127.0.0.1) ---
PRODUCT_SERVICE_PORT=3002

# --- Product Service database ---
# Same ecommerce_ prefix rule as above. This service holds NO credentials for
# the auth database, which is what database-per-service means in practice:
# a bug here cannot read users, because it has nothing to read them with.
PRODUCT_DB_HOST=localhost
PRODUCT_DB_PORT=5432
PRODUCT_DB_USERNAME=ecommerce_product_service
PRODUCT_DB_PASSWORD=change-me
PRODUCT_DB_DATABASE=ecommerce_product_db
PRODUCT_DB_LOGGING=true
PRODUCT_DB_SSL=false

# --- Redis (shared by the gateway and the product service) ---
# One Redis instance, exactly as one PostgreSQL server hosts several
# databases. Redis has no per-service isolation, so each service namespaces
# its keys with a prefix: ecom:gateway: and ecom:product:.
REDIS_URL=redis://localhost:6379

# --- CORS (gateway) ---
# Comma-separated browser origins, e.g. https://shop.example.com,http://localhost:4200
# EMPTY means no browser origin is allowed — the right default until a
# browser client exists. Never use a reflecting origin with credentials.
CORS_ALLOWED_ORIGINS=

# --- API Gateway rate limiting ---
# The global default. Endpoints that need a tighter budget declare their own
# with @RateLimit() — /auth/login is 5 per minute.
RATE_LIMIT_LIMIT=100
RATE_LIMIT_WINDOW_SECONDS=60
# What to do when Redis is unreachable.
#   true  = keep serving with no limiting (availability first)
#   false = return 503 (security first)
# See the long note in apps/api-gateway/src/common/rate-limit.guard.ts.
RATE_LIMIT_FAIL_OPEN=true

# --- Product Service caching ---
# A kill switch. Turn the cache off without a code change when you need to
# confirm whether a wrong answer came from Redis or from the database.
CACHE_ENABLED=true
# Product detail: changes rarely, and writes invalidate explicitly. The TTL
# is a backstop against a missed invalidation, not the freshness mechanism.
CACHE_PRODUCT_TTL_SECONDS=300
# List pages: much shorter, because a page reflects many rows.
CACHE_LIST_TTL_SECONDS=60

# --- Inventory Service (internal, bound to 127.0.0.1) ---
INVENTORY_SERVICE_PORT=3003

# --- Inventory Service database ---
# NOTE: no REDIS/CACHE settings for this service, on purpose. Stock figures
# must never be served from a cache — a cached "available: 1" is a promise
# the warehouse cannot keep. See apps/inventory/src/config/env.validation.ts.
INVENTORY_DB_HOST=localhost
INVENTORY_DB_PORT=5432
INVENTORY_DB_USERNAME=ecommerce_inventory_service
INVENTORY_DB_PASSWORD=change-me
INVENTORY_DB_DATABASE=ecommerce_inventory_db
INVENTORY_DB_LOGGING=true
INVENTORY_DB_SSL=false

# --- Cart Service (internal, bound to 127.0.0.1) ---
CART_SERVICE_PORT=3004

# --- Cart Service database ---
# PostgreSQL, NOT Redis. A cart is durable, queryable purchase intent — see
# the long note in apps/cart/src/database/migrations/*-create-cart-tables.js.
CART_DB_HOST=localhost
CART_DB_PORT=5432
CART_DB_USERNAME=ecommerce_cart_service
CART_DB_PASSWORD=change-me
CART_DB_DATABASE=ecommerce_cart_db
CART_DB_LOGGING=true
CART_DB_SSL=false

# --- RabbitMQ (shared by every service) ---
# Start it with:
#   docker run -d --name ecommerce-rabbitmq -p 5672:5672 -p 15672:15672 rabbitmq:3-management
# Management UI: http://localhost:15672  (guest / guest)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# The topic EXCHANGE publishers send to. Every consuming service declares
# its own queue and binds it to this exchange with the routing keys it wants,
# so two services can both receive a copy of the same event. Before Milestone
# 10 this was a single shared queue, and a second consumer would have STOLEN
# half of the first one's messages.
RABBITMQ_EXCHANGE=ecommerce.events

# --- Order Service (internal, bound to 127.0.0.1) ---
ORDER_SERVICE_PORT=3005

# --- Order Service database ---
# Its own database, like every other service. The Order Service holds no
# credentials for the cart or inventory databases — it talks to those services
# over HTTP, which is what makes 'no service reads another service's tables'
# a fact about the deployment rather than a promise about the code.
ORDER_DB_HOST=localhost
ORDER_DB_PORT=5432
ORDER_DB_USERNAME=ecommerce_order_service
ORDER_DB_PASSWORD=change-me
ORDER_DB_DATABASE=ecommerce_order_db
ORDER_DB_LOGGING=true
ORDER_DB_SSL=false

# --- Payment Service (internal, bound to 127.0.0.1) ---
PAYMENT_SERVICE_PORT=3006
# How long the gateway waits for a payment. LONGER than the service's own
# provider deadline below — an outer timeout that fires first makes the inner
# one pointless, and abandoning a charge does not cancel it.
PAYMENT_GATEWAY_TIMEOUT_MS=20000
# How long the Payment Service waits for the (mock) provider. When this
# fires, the outcome is UNKNOWN — the charge may still be settling.
PAYMENT_PROVIDER_TIMEOUT_MS=10000

# --- Payment Service database ---
# NOTE what this database must never contain: card numbers, CVVs, expiry
# dates. It stores a provider TOKEN, a last-4 and a brand. See the long note
# in apps/payment/src/database/migrations/*-create-payments-table.js.
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5432
PAYMENT_DB_USERNAME=ecommerce_payment_service
PAYMENT_DB_PASSWORD=change-me
PAYMENT_DB_DATABASE=ecommerce_payment_db
PAYMENT_DB_LOGGING=true
PAYMENT_DB_SSL=false

# --- Notification Service (internal, bound to 127.0.0.1) ---
NOTIFICATION_SERVICE_PORT=3007

# --- Notification Service database ---
# Holds a small PROJECTION of users (id, email, first name), built from the
# `user.registered` event, plus a log of every email sent. It calls no other
# service — see apps/notification/src/database/migrations/*.js for why it
# keeps its own copy instead of asking Auth.
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_USERNAME=ecommerce_notification_service
NOTIFICATION_DB_PASSWORD=change-me
NOTIFICATION_DB_DATABASE=ecommerce_notification_db
NOTIFICATION_DB_LOGGING=true
NOTIFICATION_DB_SSL=false

# --- Mail ---
# log  = print the subject and recipient, send nothing. THE DEFAULT, so the
#        stack runs with nothing extra installed.
# smtp = Nodemailer to MAIL_HOST. Start MailHog first:
#          docker run -d --name ecommerce-mailhog -p 1025:1025 -p 8025:8025 mailhog/mailhog
#        Then read the mail at http://localhost:8025
MAIL_TRANSPORT=log
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=Shop <shop@example.test>
