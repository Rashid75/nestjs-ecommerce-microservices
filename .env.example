# ---------------------------------------------------------------------------
# Milestone 2 — API Gateway + Auth Service.
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored. This file is committed and must NEVER contain a real
# secret. Every service in the monorepo reads this one file in local
# development; in production each service receives its own environment from the
# orchestrator and no .env exists at all.
#
# Database variables are PREFIXED PER SERVICE (AUTH_DB_*, later PRODUCT_DB_*,
# ORDER_DB_*). Each service owns its own database — that is the
# database-per-service rule — so an unprefixed DB_HOST would collide as soon as
# the second service appears.
# ---------------------------------------------------------------------------

# --- Shared ---
# development | test | production
NODE_ENV=development

# --- API Gateway (public) ---
API_GATEWAY_PORT=3000
# URL prefix on every gateway route: http://localhost:3000/api/auth/login
API_GLOBAL_PREFIX=api
# Where the gateway forwards authentication calls.
AUTH_SERVICE_URL=http://127.0.0.1:3001
# Deadline for every outbound call the gateway makes, in milliseconds.
HTTP_CLIENT_TIMEOUT_MS=5000

# --- Auth Service (internal, bound to 127.0.0.1) ---
AUTH_SERVICE_PORT=3001

# --- Auth Service database ---
# NAMING CONVENTION: every PostgreSQL database AND login role this project
# creates is prefixed `ecommerce_` — e.g. ecommerce_auth_db owned by
# ecommerce_auth_service, later ecommerce_product_db owned by
# ecommerce_product_service.
#
# Databases are per-cluster but ROLES ARE CLUSTER-WIDE in PostgreSQL, so an
# unprefixed `auth_service` would sit in the same namespace as every other
# project sharing this local server. The prefix keeps ownership obvious in
# `\du` and makes a stray GRANT easy to spot.
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_USERNAME=ecommerce_auth_service
# Set your own local development password. It never leaves this machine and is
# never logged. Do not reuse a password from anywhere else.
AUTH_DB_PASSWORD=change-me
AUTH_DB_DATABASE=ecommerce_auth_db
# Logs the SQL Sequelize actually emits. ON in development because seeing the
# real statements is the point; MUST be off in production.
AUTH_DB_LOGGING=true
# Local Postgres over loopback needs no TLS. This must be true for anything
# reachable over a network.
AUTH_DB_SSL=false

# --- Auth Service tokens ---
# HS256 signing key, minimum 32 characters. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value here. Never reuse this value between environments —
# a leaked development key that also signs production tokens is a full
# authentication bypass.
JWT_ACCESS_SECRET=generate-a-64-character-hex-string
# Access token lifetime. Short (15 minutes) because an access token cannot be
# revoked before it expires. Refresh tokens arrive in a later milestone.
JWT_ACCESS_TTL_SECONDS=900
# bcrypt work factor. Each +1 doubles the hashing time. 12 is a reasonable
# 2026 default; raise it as hardware improves.
BCRYPT_COST=12
