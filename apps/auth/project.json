{
  "name": "auth",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/auth/src",
  "projectType": "application",
  "tags": ["type:app", "scope:auth"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/auth"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/auth/package.json",
        "{workspaceRoot}/dist/apps/auth/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/auth/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "auth:build",
        "runBuildTargetDependencies": false,
        "port": 9230,
        "env": {
          "OTEL_SERVICE_NAME": "auth"
        }
      },
      "configurations": {
        "development": {
          "buildTarget": "auth:build:development"
        },
        "production": {
          "buildTarget": "auth:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/auth",
        "command": "sequelize-cli db:migrate",
        "forwardAllArgs": true
      }
    },
    "migrate:undo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/auth",
        "command": "sequelize-cli db:migrate:undo",
        "forwardAllArgs": true
      }
    },
    "migrate:status": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/auth",
        "command": "sequelize-cli db:migrate:status",
        "forwardAllArgs": true
      }
    },
    "migration:generate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/auth",
        "command": "sequelize-cli migration:generate",
        "forwardAllArgs": true
      }
    }
  }
}
